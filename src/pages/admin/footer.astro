---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Footer — Admin</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <script>if(!localStorage.getItem('bambulogy_admin_token')) window.location.href='/admin/login';</script>
    <div class="flex">
      <div class="w-64"><iframe src="/admin/dashboard" style="width:100%;height:100vh;border:none;"></iframe></div>
      <div class="flex-1 p-8">
        <h2 class="text-2xl font-semibold mb-4">Footer</h2>
        <form id="form" class="grid gap-3 max-w-3xl">
          <label class="text-sm text-gray-600">Description</label>
          <textarea id="description" class="p-3 border rounded h-28"></textarea>
          <label class="text-sm text-gray-600">Address</label>
          <input id="address" class="p-3 border rounded" />
          <label class="text-sm text-gray-600">Email</label>
          <input id="email" class="p-3 border rounded" />
          <label class="text-sm text-gray-600">Phone</label>
          <input id="phone" class="p-3 border rounded" />
          <label class="text-sm text-gray-600">Social Links (JSON)</label>
          <textarea id="social" class="p-3 border rounded h-28">{}</textarea>
          <label class="text-sm text-gray-600">Copyright text</label>
          <input id="copyright" class="p-3 border rounded" />
          <div class="mt-4 flex gap-3"><button class="btn-primary">Save</button><div id="msg" class="text-sm text-green-600"></div></div>
        </form>
      </div>
    </div>

    <script type="module">
      async function load(){
        const res = await fetch('/src/content/site/footer.json');
        const data = await res.json();
        document.getElementById('description').value = data.description || '';
        document.getElementById('address').value = data.address || '';
        document.getElementById('email').value = data.email || '';
        document.getElementById('phone').value = data.phone || '';
        document.getElementById('social').value = JSON.stringify(data.social || {}, null, 2);
        document.getElementById('copyright').value = data.copyright || '';
      }

      document.getElementById('form').addEventListener('submit', async (e)=>{
        e.preventDefault();
        const payload = { description: document.getElementById('description').value, address: document.getElementById('address').value, email: document.getElementById('email').value, phone: document.getElementById('phone').value, social: JSON.parse(document.getElementById('social').value||'{}'), copyright: document.getElementById('copyright').value };
        const token = localStorage.getItem('bambulogy_admin_token');
        const res = await fetch('/api/content?slug=footer', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer '+token }, body: JSON.stringify(payload) });
        const d = await res.json();
        const msg = document.getElementById('msg');
        if(res.ok) { msg.textContent = 'Saved'; setTimeout(()=>msg.textContent='', 2500);} else msg.textContent = d.error || 'Error';
      });

      load();
    </script>
  </body>
</html>