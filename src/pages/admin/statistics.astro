---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Statistics — Admin</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <script>if(!localStorage.getItem('bambulogy_admin_token')) window.location.href='/admin/login';</script>
    <div class="flex">
      <div class="w-64"><iframe src="/admin/dashboard" style="width:100%;height:100vh;border:none;"></iframe></div>
      <div class="flex-1 p-8">
        <h2 class="text-2xl font-semibold mb-4">Statistics</h2>
        <div id="list" class="grid md:grid-cols-2 gap-4"></div>
        <hr class="my-6" />
        <h3 class="font-semibold mb-2">Add Stat</h3>
        <form id="addForm" class="grid gap-2 max-w-2xl">
          <input id="sNumber" placeholder="Number" class="p-2 border rounded" />
          <input id="sLabel" placeholder="Label" class="p-2 border rounded" />
          <input id="sDesc" placeholder="Description" class="p-2 border rounded" />
          <button class="btn-primary">Add Stat</button>
        </form>
      </div>
    </div>

    <script type="module">
      async function load(){
        const res = await fetch('/src/content/site/statistics.json');
        const data = await res.json();
        const list = document.getElementById('list');
        list.innerHTML = '';
        data.stats.forEach(s=>{
          const div = document.createElement('div');
          div.className = 'p-4 border rounded bg-white';
          div.innerHTML = `<div class="flex justify-between items-start"><div><div class="font-semibold">${s.number} — ${s.label}</div><div class="text-sm text-gray-600">${s.description}</div></div><div><button data-id="${s.id}" class="delBtn p-1 text-sm border rounded">Delete</button></div></div>`;
          list.appendChild(div);
        });

        document.querySelectorAll('.delBtn').forEach(btn=>btn.addEventListener('click', async (e)=>{
          const id = e.target.dataset.id;
          data.stats = data.stats.filter(x=>x.id!==id);
          const token = localStorage.getItem('bambulogy_admin_token');
                    await fetch('/api/content?slug=statistics', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer '+token }, body: JSON.stringify(data) });
          load();
        }));
      }

      document.getElementById('addForm').addEventListener('submit', async (e)=>{
        e.preventDefault();
        const number = document.getElementById('sNumber').value;
        const label = document.getElementById('sLabel').value;
        const desc = document.getElementById('sDesc').value;
        const res = await fetch('/src/content/site/statistics.json');
        const data = await res.json();
        const id = 'stat-'+Date.now();
        data.stats.push({ id, number, label, description: desc });
        const token = localStorage.getItem('bambulogy_admin_token');
                await fetch('/api/content?slug=statistics', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer '+token }, body: JSON.stringify(data) });
        document.getElementById('addForm').reset();
        load();
      });

      load();
    </script>
  </body>
</html>