---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>News — Admin</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <script>if(!localStorage.getItem('bambulogy_admin_token')) window.location.href='/admin/login';</script>
    <div class="flex">
      <div class="w-64"><iframe src="/admin/dashboard" style="width:100%;height:100vh;border:none;"></iframe></div>
      <div class="flex-1 p-8">
        <h2 class="text-2xl font-semibold mb-4">News & Articles</h2>
        <div id="list" class="grid gap-4"></div>
        <hr class="my-6" />
        <h3 class="font-semibold mb-2">Add Post</h3>
        <form id="addForm" class="grid gap-2 max-w-3xl">
          <input id="tTitle" placeholder="Title" class="p-2 border rounded" />
          <input id="tShort" placeholder="Short Description" class="p-2 border rounded" />
          <input id="tCover" placeholder="Cover Image URL" class="p-2 border rounded" />
          <input id="tDate" placeholder="Date (YYYY-MM-DD)" class="p-2 border rounded" />
          <input id="tCategory" placeholder="Category" class="p-2 border rounded" />
          <textarea id="tContent" placeholder="Content" class="p-2 border rounded h-36"></textarea>
          <button class="btn-primary">Create Post</button>
        </form>
      </div>
    </div>

    <script type="module">
      async function load(){
        const res = await fetch('/src/content/site/news.json');
        const data = await res.json();
        const list = document.getElementById('list');
        list.innerHTML = '';
        (data.posts||[]).forEach(p=>{
          const div = document.createElement('div');
          div.className = 'p-4 border rounded bg-white';
          div.innerHTML = `<div class="flex justify-between items-start"><div><div class="font-semibold">${p.title}</div><div class="text-sm text-gray-600">${p.short} — ${p.date}</div></div><div><button data-id="${p.id}" class="editBtn p-1 text-sm border rounded">Edit</button> <button data-id="${p.id}" class="delBtn p-1 text-sm border rounded">Delete</button></div></div>`;
          list.appendChild(div);
        });

        document.querySelectorAll('.delBtn').forEach(btn=>btn.addEventListener('click', async (e)=>{
          const id = e.target.dataset.id;
          data.posts = data.posts.filter(x=>x.id!==id);
          const token = localStorage.getItem('bambulogy_admin_token');
                    await fetch('/api/content?slug=news', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer '+token }, body: JSON.stringify(data) });
          load();
        }));

        document.querySelectorAll('.editBtn').forEach(btn=>btn.addEventListener('click', async (e)=>{
          const id = e.target.dataset.id;
          const post = data.posts.find(x=>x.id===id);
          const newTitle = prompt('Title', post.title);
          if(newTitle==null) return;
          const newShort = prompt('Short', post.short);
          post.title = newTitle;
          post.short = newShort;
          const token = localStorage.getItem('bambulogy_admin_token');
          await fetch('/api/content/news', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer '+token }, body: JSON.stringify(data) });
          load();
        }));
      }

      document.getElementById('addForm').addEventListener('submit', async (e)=>{
        e.preventDefault();
        const title = document.getElementById('tTitle').value;
        const short = document.getElementById('tShort').value;
        const cover = document.getElementById('tCover').value;
        const date = document.getElementById('tDate').value;
        const category = document.getElementById('tCategory').value;
        const content = document.getElementById('tContent').value;
        const res = await fetch('/src/content/site/news.json');
        const data = await res.json();
        const id = 'post-'+Date.now();
        data.posts.push({ id, title, short, coverImage: cover, date, category, content });
        const token = localStorage.getItem('bambulogy_admin_token');
                await fetch('/api/content?slug=news', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer '+token }, body: JSON.stringify(data) });
        document.getElementById('addForm').reset();
        load();
      });

      load();
    </script>
  </body>
</html>