---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Business Units — Admin</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <script>if(!localStorage.getItem('bambulogy_admin_token')) window.location.href='/admin/login';</script>
    <div class="flex">
      <div class="w-64"><iframe src="/admin/dashboard" style="width:100%;height:100vh;border:none;"></iframe></div>
      <div class="flex-1 p-8">
        <h2 class="text-2xl font-semibold mb-4">Business Units</h2>
        <div id="list" class="grid gap-4"></div>
        <hr class="my-6" />
        <h3 class="font-semibold mb-2">Add New Unit</h3>
        <form id="addForm" class="grid gap-2 max-w-2xl">
          <input id="newTitle" placeholder="Title" class="p-2 border rounded" />
          <input id="newDesc" placeholder="Description" class="p-2 border rounded" />
          <input id="newIcon" placeholder="Icon (emoji or short)" class="p-2 border rounded" />
          <input id="newImage" placeholder="Image URL" class="p-2 border rounded" />
          <button class="btn-primary">Add Unit</button>
        </form>
      </div>
    </div>

    <script type="module">
      async function load(){
        const res = await fetch('/src/content/site/businessUnits.json');
        const data = await res.json();
        const list = document.getElementById('list');
        list.innerHTML = '';
        data.units.forEach(u=>{
          const div = document.createElement('div');
          div.className = 'p-4 border rounded bg-white';
          div.innerHTML = `<div class="flex justify-between items-start"><div><div class="font-semibold">${u.title}</div><div class="text-sm text-gray-600">${u.description}</div></div><div><button data-id="${u.id}" class="editBtn p-1 text-sm border rounded">Edit</button> <button data-id="${u.id}" class="delBtn p-1 text-sm border rounded">Delete</button></div></div>`;
          list.appendChild(div);
        });

        document.querySelectorAll('.delBtn').forEach(btn=>btn.addEventListener('click', async (e)=>{
          const id = e.target.dataset.id;
          data.units = data.units.filter(x=>x.id!==id);
          const token = localStorage.getItem('bambulogy_admin_token');
          await fetch('/api/content?slug=businessUnits', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer '+token }, body: JSON.stringify(data) });
          load();
        }));

        document.querySelectorAll('.editBtn').forEach(btn=>btn.addEventListener('click', async (e)=>{
          const id = e.target.dataset.id;
          const unit = data.units.find(x=>x.id===id);
          const newTitle = prompt('Title', unit.title);
          if(newTitle==null) return;
          const newDesc = prompt('Description', unit.description);
          unit.title = newTitle;
          unit.description = newDesc;
          const token = localStorage.getItem('bambulogy_admin_token');
          await fetch('/api/content?slug=businessUnits', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer '+token }, body: JSON.stringify(data) });
          load();
        }));
      }

      document.getElementById('addForm').addEventListener('submit', async (e)=>{
        e.preventDefault();
        const title = document.getElementById('newTitle').value;
        const desc = document.getElementById('newDesc').value;
        const icon = document.getElementById('newIcon').value || '🏨';
        const image = document.getElementById('newImage').value || '';
        const res = await fetch('/src/content/site/businessUnits.json');
        const data = await res.json();
        const id = 'unit-'+Date.now();
        data.units.push({ id, title, description: desc, icon, image });
        const token = localStorage.getItem('bambulogy_admin_token');
        await fetch('/api/content?slug=businessUnits', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer '+token }, body: JSON.stringify(data) });
        document.getElementById('addForm').reset();
        load();
      });

      load();
    </script>
  </body>
</html>