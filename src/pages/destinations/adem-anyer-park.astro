---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PropertyAvailability from '../../components/PropertyAvailability.astro';
import header from '../../content/site/header.json';
import footer from '../../content/site/footer.json';

const heroImage = 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1800&q=80';
const gallery = [
  'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80',
  'https://images.unsplash.com/photo-1493558103817-58b2924bce98?auto=format&fit=crop&w=1200&q=80',
  'https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=1200&q=80',
  'https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=1200&q=80'
];
const highlights = [
  'Beachfront Stay',
  'Cabin & Glamping Experience',
  'Campervan Area',
  'Water Activities',
  'Family Recreation',
  'Corporate Gathering',
  'Event Venue'
];
const accommodations = [
  { title: 'Oceanfront Cabin', description: 'Comfortable stay with sea views and warm coastal hospitality for weekend escapes.', image: 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=900&q=80' },
  { title: 'Glamping Tents', description: 'Open-air luxury experience with a natural atmosphere and instant sunset access.', image: 'https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=900&q=80' },
  { title: 'Campervan Area', description: 'Flexible outdoor lodging for family travelers and event groups seeking adventure.', image: 'https://images.unsplash.com/photo-1519046904884-53103b34b206?auto=format&fit=crop&w=900&q=80' }
];
const activities = [
  'Sunset beach lounging and family beachtime',
  'Water sport activities and coastal recreation',
  'Group games and team-building experiences',
  'Private event planning and celebration setups'
];
const facilities = [
  'Event lawn for gatherings and wedding receptions',
  'Open social spaces for community programs',
  'Flexible meeting points for corporate retreats',
  'Dining and lounge setups overlooking the shoreline'
];
---
<BaseLayout
  title="Adem Anyer Park | Bambulogy Group"
  description="Beachfront destination in Anyer with cabins, glamping, campervan experiences, water activities, and event facilities."
>
  <Navbar data={header} />

  <main class="pt-24">
    <section class="relative overflow-hidden">
      <img src={heroImage} alt="Adem Anyer Park" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0f2d1e]/85 via-[#0f2d1e]/50 to-[#0f2d1e]/20"></div>

      <div class="container relative z-10 py-28 md:py-40">
        <div class="max-w-3xl text-white">
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.28em] text-[#E7D7AE]">Bambulogy destination</p>
          <h1 class="text-4xl font-bold leading-tight md:text-6xl">Adem Anyer Park</h1>
          <p class="mt-5 max-w-2xl text-lg md:text-2xl text-white/90">
            Beachfront Escape for Families, Communities, and Corporate Gatherings.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#about" class="btn-primary">Explore Destination</a>
            <a href="https://wa.me/6285861214132?text=Hello%20Bambulogy%2C%20I%20want%20to%20book%20Adem%20Anyer%20Park" target="_blank" rel="noopener noreferrer" class="btn-secondary">Book Now</a>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="section bg-[#f9f7f4]">
      <div class="container grid gap-10 md:grid-cols-2 md:items-center">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-[#58715d]">About destination</p>
          <h2 class="text-3xl md:text-5xl font-bold text-[#102920]">A coastal retreat built for memorable stays.</h2>
          <div class="mt-6 space-y-4 text-lg leading-8 text-gray-700">
            <p>
              Adem Anyer Park is a beachfront destination managed by Bambulogy Group that combines accommodation, outdoor recreation, and event facilities within one integrated coastal retreat.
            </p>
            <p>
              Guests can enjoy cabins, glamping units, campervan areas, and various water-based activities while experiencing the beauty of Anyer’s shoreline. The destination is designed to serve family vacations, group gatherings, corporate outings, and memorable outdoor events.
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-[32px] border border-[#e5dfd3] bg-white p-4 shadow-[0_24px_90px_rgba(9,25,20,0.08)]">
          <img src={heroImage} alt="Adem Anyer Park beachfront view" class="h-[420px] w-full rounded-[24px] object-cover transition duration-700 hover:scale-[1.03]" />
          <div class="mt-5 grid grid-cols-3 gap-4 text-center">
            <div class="rounded-2xl bg-[#eef5f2] p-4">
              <div class="text-2xl font-bold text-[#102920]">7+</div>
              <div class="mt-1 text-xs uppercase tracking-[0.15em] text-gray-600">Experience zones</div>
            </div>
            <div class="rounded-2xl bg-[#eef5f2] p-4">
              <div class="text-2xl font-bold text-[#102920]">24/7</div>
              <div class="mt-1 text-xs uppercase tracking-[0.15em] text-gray-600">Guest access</div>
            </div>
            <div class="rounded-2xl bg-[#eef5f2] p-4">
              <div class="text-2xl font-bold text-[#102920]">4.9</div>
              <div class="mt-1 text-xs uppercase tracking-[0.15em] text-gray-600">Guest rating</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-[#f2f8f8]">
      <div class="container">
        <div class="mb-10">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#58715d]">Key experiences</p>
          <h2 class="mt-2 text-3xl md:text-5xl font-bold text-[#102920]">Designed for everyone</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {highlights.map((item) => (
            <div class="rounded-[24px] border border-[#dfe8e4] bg-white p-5 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">
              <div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#102920] text-sm font-bold text-white">✓</div>
              <p class="text-lg font-semibold text-[#102920]">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section bg-white">
      <div class="container">
        <div class="mb-10">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#58715d]">Accommodation</p>
          <h2 class="mt-2 text-3xl md:text-5xl font-bold text-[#102920]">Stay your way</h2>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {accommodations.map((item) => (
            <article class="group overflow-hidden rounded-[28px] border border-[#eae3d6] bg-[#fbfaf8] shadow-[0_18px_60px_rgba(16,41,32,0.06)] transition duration-500 hover:-translate-y-2 hover:shadow-[0_28px_70px_rgba(16,41,32,0.12)]">
              <div class="overflow-hidden">
                <img src={item.image} alt={item.title} class="h-72 w-full object-cover transition duration-700 group-hover:scale-110" />
              </div>
              <div class="p-6">
                <h3 class="text-2xl font-bold text-[#102920]">{item.title}</h3>
                <p class="mt-3 text-sm leading-6 text-gray-700">{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section bg-[#f9f2ee]">
      <div class="container grid gap-10 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#58715d]">Activities</p>
          <h2 class="mt-2 text-3xl md:text-5xl font-bold text-[#102920]">Experience the shoreline</h2>
          <div class="mt-6 space-y-4">
            {activities.map((item) => (
              <div class="flex items-start gap-4 rounded-2xl bg-white p-4 shadow-sm">
                <div class="mt-1 inline-flex h-8 w-8 items-center justify-center rounded-full bg-[#dfeee9] text-[#102920] font-bold">•</div>
                <p class="text-base text-gray-700">{item}</p>
              </div>
            ))}
          </div>
        </div>

        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#58715d]">Gatherings</p>
          <h2 class="mt-2 text-3xl md:text-5xl font-bold text-[#102920]">Built for events</h2>
          <div class="mt-6 space-y-4">
            {facilities.map((item) => (
              <div class="flex items-start gap-4 rounded-2xl bg-white p-4 shadow-sm">
                <div class="mt-1 inline-flex h-8 w-8 items-center justify-center rounded-full bg-[#dfeee9] text-[#102920] font-bold">✦</div>
                <p class="text-base text-gray-700">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <PropertyAvailability
      propertyName="Adem Anyer Park"
      roomOptions={[
        { label: 'Oceanfront Cabin', availability: 8 },
        { label: 'Glamping Tent', availability: 6 },
        { label: 'Campervan Spot', availability: 5 }
      ]}
    />

    <section class="section bg-white">
      <div class="container">
        <div class="mb-10">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#58715d]">Photo gallery</p>
          <h2 class="mt-2 text-3xl md:text-5xl font-bold text-[#102920]">A view worth sharing</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {gallery.map((image, index) => (
            <div class="overflow-hidden rounded-[24px] border border-[#eae3d6] bg-[#faf5ef] shadow-sm transition duration-500 hover:-translate-y-1 hover:shadow-lg">
              <img src={image} alt={`Adem Anyer Park gallery ${index + 1}`} class="h-72 w-full object-cover transition duration-700 hover:scale-105" />
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section bg-[#0f2d1e]">
      <div class="container">
        <div class="rounded-[32px] border border-white/10 bg-gradient-to-r from-[#0f2d1e] via-[#153a2d] to-[#1e4a3d] p-8 md:p-12 text-center text-white">
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[#d7d2a8]">Plan your escape</p>
          <h2 class="mt-4 text-3xl md:text-5xl font-bold">Book your next seaside getaway.</h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-white/80">
            Whether for a family vacation, a community gathering, or a corporate retreat, Adem Anyer Park brings coastal comfort and meaningful experiences together.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a href="https://wa.me/6285861214132?text=Hello%20Bambulogy%2C%20I%20want%20to%20book%20Adem%20Anyer%20Park" target="_blank" rel="noopener noreferrer" class="btn-primary bg-[#f8f3ea] text-[#102920] hover:opacity-95">Reserve Your Stay</a>
            <a href="/" class="btn-secondary border-white/30 text-white hover:bg-white/5">Back to Home</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer data={footer} />
</BaseLayout>
