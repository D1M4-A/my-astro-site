---
const { title = 'Admin' } = Astro.props;
---
<div class="min-h-screen bg-[#F6F4EF] text-[#111827]">
  <div class="flex">
    <slot name="sidebar" />
    <div class="flex-1">
      <slot name="topbar" />
      <main class="p-6">
        <h1 class="text-2xl font-semibold mb-4">{title}</h1>
        <slot />
      </main>
    </div>
  </div>
</div>
