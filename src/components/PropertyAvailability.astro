---
const {
  propertyName = 'Bambulogy Property',
  roomOptions = [
    { label: 'Deluxe Cabin', availability: 6 },
    { label: 'Family Suite', availability: 4 },
    { label: 'Premium Terrace', availability: 3 }
  ]
} = Astro.props;
const today = new Date();
const isoToday = today.toISOString().slice(0, 10);
const isoPlusThree = new Date(today.getTime() + 3 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);
const resultId = propertyName.toLowerCase().replace(/\s+/g, '-') + '-availability-result';
const whatsappLink = `https://wa.me/6285861214132?text=${encodeURIComponent(`Hello Bambulogy, I want to check room availability for ${propertyName}.`)}`;
---
<section class="section bg-[#f6f2eb]">
  <div class="container">
    <div class="rounded-[32px] border border-[#e7dfd3] bg-white p-6 shadow-[0_25px_80px_rgba(16,41,32,0.06)] md:p-10">
      <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#58715d]">Availability</p>
          <h2 class="mt-2 text-3xl md:text-5xl font-bold text-[#102920]">Check room availability</h2>
        </div>
        <div class="rounded-full bg-[#edf5f1] px-4 py-2 text-sm font-medium text-[#102920]">
          {propertyName}
        </div>
      </div>

      <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
        <form class="availability-form grid gap-4 md:grid-cols-3" data-property={propertyName}>
          <label class="block">
            <span class="mb-2 block text-sm font-medium text-gray-700">Check-in</span>
            <input
              name="checkin"
              type="date"
              min={isoToday}
              value={isoToday}
              class="w-full rounded-2xl border border-[#dfe7df] bg-[#f9f9f7] px-4 py-3 text-[#102920] outline-none ring-0 transition focus:border-[#102920]"
            />
          </label>

          <label class="block">
            <span class="mb-2 block text-sm font-medium text-gray-700">Check-out</span>
            <input
              name="checkout"
              type="date"
              min={isoPlusThree}
              value={isoPlusThree}
              class="w-full rounded-2xl border border-[#dfe7df] bg-[#f9f9f7] px-4 py-3 text-[#102920] outline-none ring-0 transition focus:border-[#102920]"
            />
          </label>

          <label class="block">
            <span class="mb-2 block text-sm font-medium text-gray-700">Guests</span>
            <select name="guests" class="w-full rounded-2xl border border-[#dfe7df] bg-[#f9f9f7] px-4 py-3 text-[#102920] outline-none transition focus:border-[#102920]">
              <option value="2">2 Guests</option>
              <option value="4">4 Guests</option>
              <option value="6">6 Guests</option>
              <option value="8">8 Guests</option>
            </select>
          </label>

          <div class="md:col-span-3 flex flex-col gap-3 sm:flex-row sm:items-center">
            <button
              type="submit"
              class="inline-flex min-h-[52px] w-full items-center justify-center rounded-full bg-[#102920] px-6 py-3 text-base font-bold text-white shadow-[0_12px_24px_rgba(16,41,32,0.2)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#234a3b] sm:w-auto"
            >
              Check Availability
            </button>
            <a
              href={whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[52px] w-full items-center justify-center rounded-full border-2 border-[#c7a968] bg-[#f8f2e3] px-6 py-3 text-base font-bold text-[#102920] shadow-[0_10px_20px_rgba(199,169,104,0.18)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#efe1b6] sm:w-auto"
            >
              WhatsApp Booking
            </a>
          </div>
        </form>

        <div class="rounded-[28px] border border-[#e6e3db] bg-[#f5f8f5] p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#58715d]">Result</p>
          <div class="mt-4 space-y-4" id={resultId}>
            <div class="rounded-2xl bg-white p-4 shadow-sm">
              <p class="text-sm text-gray-600">Selected stay</p>
              <p class="mt-1 text-lg font-semibold text-[#102920]">Check available rooms for your date range</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline data-room-options={JSON.stringify(roomOptions)}>
    const roomOptions = JSON.parse(document.currentScript.dataset.roomOptions || '[]');

    document.addEventListener('DOMContentLoaded', () => {
      const forms = document.querySelectorAll('.availability-form');
      forms.forEach((form) => {
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          const checkin = form.querySelector('input[name="checkin"]').value;
          const checkout = form.querySelector('input[name="checkout"]').value;
          const guests = form.querySelector('select[name="guests"]').value;
          const resultBox = document.getElementById(`${form.dataset.property.toLowerCase().replace(/\s+/g, '-')}-availability-result`);

          if (!checkin || !checkout) {
            if (resultBox) {
              resultBox.innerHTML = '<div class="rounded-2xl bg-white p-4 shadow-sm"><p class="text-red-600">Please select both check-in and check-out dates.</p></div>';
            }
            return;
          }

          if (new Date(checkout) <= new Date(checkin)) {
            if (resultBox) {
              resultBox.innerHTML = '<div class="rounded-2xl bg-white p-4 shadow-sm"><p class="text-red-600">Check-out must be after check-in date.</p></div>';
            }
            return;
          }

          const nights = Math.max(1, Math.round((new Date(checkout) - new Date(checkin)) / 86400000));
          const filtered = roomOptions.map((room) => {
            const base = Number(room.availability || 0);
            const adjustment = Number(guests) > 4 ? Math.max(0, base - 2) : base;
            const available = Math.max(0, adjustment - (nights > 3 ? 1 : 0));
            return { ...room, available };
          });

          const status = filtered.some((room) => room.available > 0) ? 'Available' : 'Unavailable';

          if (resultBox) {
            resultBox.innerHTML = `
              <div class="rounded-2xl bg-white p-4 shadow-sm">
                <p class="text-sm text-gray-600">Stay summary</p>
                <p class="mt-2 text-xl font-bold text-[#102920]">${status} for ${nights} night${nights > 1 ? 's' : ''}</p>
                <p class="mt-2 text-sm text-gray-600">Guests: ${guests}</p>
              </div>
              <div class="space-y-3">
                ${filtered.map((room) => `
                  <div class="flex items-center justify-between rounded-2xl bg-white p-4 shadow-sm">
                    <span class="font-medium text-[#102920]">${room.label}</span>
                    <span class="rounded-full bg-[#eef5f1] px-3 py-1 text-sm font-semibold ${room.available > 0 ? 'text-[#102920]' : 'text-red-600'}">${room.available} room${room.available > 1 ? 's' : ''} available</span>
                  </div>
                `).join('')}
              </div>
            `;
          }
        });
      });
    });
  </script>
</section>
