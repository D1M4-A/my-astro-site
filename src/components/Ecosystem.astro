---
const destinations = [
  {
    title: 'Adem Anyer Park',
    subtitle: 'Beachfront Escape for Families, Communities, and Corporate Gatherings.',
    description: 'A coastal destination offering cabins, glamping, campervan areas, and event spaces designed for unforgettable family and corporate experiences.',
    href: '/destinations/adem-anyer-park',
    image: 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1400&q=80',
    badge: 'Beachfront Resort'
  },
  {
    title: 'Cabinite Pangalengan',
    subtitle: 'Private Mountain Cabins Surrounded by Nature.',
    description: 'An exclusive retreat in the cool highlands with pine forest views, outdoor activities, and memorable nature-based gatherings.',
    href: '/destinations/cabinite-pangalengan',
    image: 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1400&q=80',
    badge: 'Mountain Retreat'
  }
];
---
<section id="businesses" class="section bg-[#F8F5F0]">
  <div class="container">
    <div class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="mb-2 text-sm font-semibold uppercase tracking-[0.2em] text-[#6A7A61]">Our destinations</p>
        <h3 class="text-3xl md:text-5xl font-bold text-[#102920]">Discover Bambulogy Places</h3>
      </div>
      <a href="/destinations/adem-anyer-park" class="inline-flex items-center gap-2 text-sm font-semibold text-[#102920] transition hover:text-[#264e3f]">
        View all experiences
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      {destinations.map((item) => (
        <a
          href={item.href}
          class="group relative block overflow-hidden rounded-[30px] border border-[#E7E1D5] bg-white shadow-[0_20px_60px_rgba(19,33,27,0.08)] transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_28px_80px_rgba(19,33,27,0.14)]"
        >
          <div class="relative overflow-hidden">
            <img
              src={item.image}
              alt={item.title}
              class="h-[380px] w-full object-cover transition-transform duration-700 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#102920]/80 via-[#102920]/15 to-transparent"></div>
            <div class="absolute left-5 top-5 inline-flex items-center rounded-full border border-white/30 bg-white/10 px-3 py-1 text-xs font-medium uppercase tracking-[0.18em] text-white backdrop-blur-sm">
              {item.badge}
            </div>
          </div>

          <div class="p-6 md:p-8">
            <h4 class="text-2xl md:text-3xl font-bold text-[#102920]">{item.title}</h4>
            <p class="mt-3 text-base font-medium text-[#456C5A]">{item.subtitle}</p>
            <p class="mt-4 text-sm leading-6 text-gray-700">{item.description}</p>

            <div class="mt-6 flex items-center justify-between gap-4">
              <span class="inline-flex items-center justify-center rounded-full bg-[#102920] px-5 py-3 text-sm font-semibold text-white transition group-hover:bg-[#234a3b]">
                Explore Destination →
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
