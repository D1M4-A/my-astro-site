---
const { data } = Astro.props;
const menu = data?.menu || [{label:'Home',link:'/'},{label:'Businesses',link:'#businesses'}];
---
<header class="fixed inset-x-0 top-0 z-50 bg-transparent">
  <div class="container flex items-center justify-between py-6">
    <a href="/" class="flex items-center gap-3">
      <div class="w-11 h-11 rounded-lg bg-[#0F2D1E] text-white flex items-center justify-center font-semibold"><img src={data?.logoUrl} alt="logo" class="w-8 h-8 object-cover rounded" /></div>
      <div class="leading-tight">
        <div class="text-sm font-semibold">{data?.siteName || 'Bambulogy'}</div>
        <div class="text-xs text-[#6B6B6B]">Group</div>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      {menu.map(item => (
        <a href={item.link} class="hover:text-secondary">{item.label}</a>
      ))}
    </nav>

    <div class="hidden md:flex items-center gap-4">
      <a href={data?.cta?.link || '#contact'} class="btn-secondary">{data?.cta?.text || 'Contact'}</a>
      <a href="/admin/login" class="px-4 py-2 border border-[#0F2D1E] text-[#0F2D1E] rounded hover:bg-[#0F2D1E] hover:text-white transition">Login</a>
    </div>

    <div class="md:hidden flex items-center gap-2">
      <a href="/admin/login" class="text-sm px-3 py-1 border border-[#E6E1DA] rounded">Login</a>
      <button aria-label="Open menu" class="p-2 rounded-full border border-[#E6E1DA]">☰</button>
    </div>
  </div>
</header>
