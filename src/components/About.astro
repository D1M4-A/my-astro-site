---
import { getCurrentLanguage } from '../lib/i18n';

const lang = getCurrentLanguage();
const { data } = Astro.props;

const aboutTitle = lang === 'en'
  ? data?.title || 'About Company'
  : data?.titleId || data?.title || 'Tentang Perusahaan';

const aboutDescription = lang === 'en'
  ? data?.description || 'Bambulogy Group is a hospitality and resort management company that creates unique stays and curated outdoor experiences across Indonesia.'
  : data?.descriptionId || data?.description || 'Bambulogy Group adalah perusahaan manajemen perhotelan dan resort yang menciptakan penginapan unik dan pengalaman outdoor kurasi di seluruh Indonesia.';

const contactText = lang === 'en'
  ? data?.cta?.label || 'Contact Corporate'
  : data?.cta?.labelId || data?.cta?.label || 'Hubungi Korporat';
---
<section class="section bg-background">
  <div class="container grid md:grid-cols-2 gap-10 items-center">
    <div class="fade-in">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">{aboutTitle}</h2>
      <div class="text-lg text-gray-700 mb-6 whitespace-pre-line">
        {aboutDescription}
      </div>
      <a href={data?.cta?.href || '#contact'} class="btn-primary">{contactText}</a>
    </div>

    <div class="fade-in">
      <div class="card-glass">
        <img src={data?.image || 'https://images.unsplash.com/photo-1501594907352-04cda38ebc29?auto=format&fit=crop&w=1400&q=80'} alt="Resort masterplan aerial" class="w-full h-64 object-cover rounded-xl" />
      </div>
    </div>
  </div>
</section>
