---
---
<section id="destinations" class="py-20 px-6 lg:px-12 reveal">
  <div class="max-w-7xl mx-auto">
    <h2 class="font-serif text-3xl text-[#32513E] mb-8">Destinations</h2>

    <div class="grid gap-6 grid-cols-1 md:grid-cols-3">
      <article class="bg-white rounded overflow-hidden shadow">
        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=1200&auto=format&fit=crop&ixlib=rb-4.0.3&s=1" alt="Atra Bambulogy Bali" class="w-full h-56 object-cover"/>
        <div class="p-4">
          <h3 class="text-xl font-semibold">Atra Bambulogy Bali</h3>
          <p class="text-sm text-gray-600 mt-2">Comfortable bamboo villas in Umalas offering a tranquil tropical experience.</p>
          <div class="mt-4 flex gap-3">
            <a class="text-sm bg-[#4C6A52] text-white px-3 py-2 rounded" href="#">Gallery</a>
            <a class="text-sm border px-3 py-2 rounded" href="#">Book Now</a>
          </div>
        </div>
      </article>

      <article class="bg-white rounded overflow-hidden shadow">
        <img src="https://images.unsplash.com/photo-1501785888041-af3ef285b470?q=80&w=1200&auto=format&fit=crop&ixlib=rb-4.0.3&s=1" alt="Cabinite Pangalengan" class="w-full h-56 object-cover"/>
        <div class="p-4">
          <h3 class="text-xl font-semibold">Cabinite Pangalengan</h3>
          <p class="text-sm text-gray-600 mt-2">Exclusive mountain cabins with tea plantation views and premium outdoor experiences.</p>
          <div class="mt-4 flex gap-3">
            <a class="text-sm bg-[#4C6A52] text-white px-3 py-2 rounded" href="#">Gallery</a>
            <a class="text-sm border px-3 py-2 rounded" href="#">Book Now</a>
          </div>
        </div>
      </article>

      <article class="bg-white rounded overflow-hidden shadow">
        <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=1200&auto=format&fit=crop&ixlib=rb-4.0.3&s=1" alt="Adem Anyer Park" class="w-full h-56 object-cover"/>
        <div class="p-4">
          <h3 class="text-xl font-semibold">Adem Anyer Park</h3>
          <p class="text-sm text-gray-600 mt-2">Beachfront destination featuring cabins, glamping, campervan areas, and group events.</p>
          <div class="mt-4 flex gap-3">
            <a class="text-sm bg-[#4C6A52] text-white px-3 py-2 rounded" href="#">Gallery</a>
            <a class="text-sm border px-3 py-2 rounded" href="#">Book Now</a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>