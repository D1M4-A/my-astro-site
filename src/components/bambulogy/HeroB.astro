---
---
<section class="relative h-screen flex items-center overflow-hidden">
  <div class="absolute inset-0">
    <picture>
      <source media="(min-width:1024px)" srcset="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=2000&auto=format&fit=crop&ixlib=rb-4.0.3&s=1" />
      <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=1200&auto=format&fit=crop&ixlib=rb-4.0.3&s=1" class="w-full h-full object-cover brightness-75" alt="Tropical resort" />
    </picture>
  </div>

  <div class="relative z-10 px-6 lg:px-12 max-w-4xl mx-auto text-center text-white">
    <h1 class="font-serif text-4xl md:text-6xl leading-tight mb-4 drop-shadow">Connecting People with Nature Through Unique Destinations</h1>
    <p class="text-lg md:text-xl text-[#F4F0E6]/90 mb-6">Experience eco-luxury accommodations, breathtaking landscapes, and unforgettable adventures across Indonesia.</p>
    <div class="flex justify-center gap-4">
      <a href="#destinations" class="bg-[#32513E] text-white px-6 py-3 rounded-md shadow hover:scale-[1.02] transition">Explore Destinations</a>
      <a href="#contact" class="bg-white text-[#32513E] px-6 py-3 rounded-md shadow hover:scale-[1.02] transition">Contact Us</a>
    </div>
  </div>

  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white text-sm opacity-80">Scroll to explore ↓</div>
</section>