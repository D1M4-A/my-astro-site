---
---
<section id="contact" class="py-20 px-6 lg:px-12 reveal">
  <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-8">
    <div>
      <h2 class="font-serif text-3xl text-[#32513E] mb-4">Contact</h2>
      <p class="mb-4">Reach out for bookings, corporate partnerships, and enquiries.</p>
      <div class="mb-4">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18" class="w-full h-64 rounded"></iframe>
      </div>
      <div class="flex gap-3">
        <a class="bg-[#32513E] text-white px-4 py-2 rounded" href="https://wa.me/">WhatsApp</a>
      </div>
    </div>
    <form class="bg-white rounded shadow p-6">
      <label class="block mb-2 text-sm">Name</label>
      <input class="w-full p-3 border rounded mb-3" />
      <label class="block mb-2 text-sm">Company</label>
      <input class="w-full p-3 border rounded mb-3" />
      <label class="block mb-2 text-sm">Email</label>
      <input class="w-full p-3 border rounded mb-3" />
      <label class="block mb-2 text-sm">Phone</label>
      <input class="w-full p-3 border rounded mb-3" />
      <label class="block mb-2 text-sm">Message</label>
      <textarea class="w-full p-3 border rounded mb-3"></textarea>
      <button class="bg-[#4C6A52] text-white px-4 py-2 rounded">Send</button>
    </form>
  </div>
</section>