---
const { data } = Astro.props;
---
<section id="investment" class="section">
  <div class="container grid md:grid-cols-2 gap-8 items-center">
    <div class="fade-in">
      <h3 class="text-3xl font-semibold mb-4">{data?.title || 'Investing in Experiences, Destinations, and the Future'}</h3>
      <p class="text-gray-700 mb-6">{data?.description || 'Bambulogy Group invites strategic partners and investors to join in curated growth opportunities.'}</p>
      <a href={data?.cta?.link || '/Bambulogy-Investment-Profile.pdf'} class="btn-primary">{data?.cta?.text || 'Download Investment Profile'}</a>
    </div>
    <div class="fade-in">
      <img src={data?.backgroundImage || 'https://images.unsplash.com/photo-1542223616-6b5f95d1b9de?auto=format&fit=crop&w=1400&q=80'} alt="Business meeting" class="w-full h-80 object-cover rounded-lg shadow-md" />
    </div>
  </div>
</section>
