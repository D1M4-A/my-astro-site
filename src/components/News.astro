---
const { data, lang = 'id' } = Astro.props;
const posts = data?.posts || [];
const title = data?.title || (lang === 'en' ? 'News & Media' : 'Berita & Media');
---
<section id="news" class="section">
  <div class="container">
    <h3 class="text-2xl md:text-3xl font-semibold mb-8">{title}</h3>
    <div class="grid md:grid-cols-3 gap-6">
      {posts.map(p => (
        <article class="card-glass p-6">
          <img src={p.coverImage} alt={p.title} class="w-full h-40 object-cover rounded mb-4" />
          <h4 class="font-semibold mb-2">{p.title}</h4>
          <p class="text-sm text-gray-700">{p.short}</p>
          <div class="mt-3 text-xs text-gray-500">{p.date} • {p.category}</div>
        </article>
      ))}
    </div>
  </div>
</section>
