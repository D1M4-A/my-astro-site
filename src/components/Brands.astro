---
const { data } = Astro.props;
const brands = data?.brands || [];
---
<section class="section">
  <div class="container">
    <h3 class="text-2xl md:text-3xl font-semibold mb-8">Featured Brands</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {brands.map(b => (
        <div class="brand-card">
          <img src={b.image} alt={b.name} class="w-full h-96 object-cover" />
          <div class="p-6 bg-white">
            <h4 class="text-xl font-semibold">{b.name}</h4>
            <p class="text-sm text-gray-700 mt-2">{b.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
