# Supabase configuration (fill these and copy to .env)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Note: SERVICE_ROLE_KEY is sensitive. Use it only on trusted server-side environments.
# After setting, run:
#   node scripts/migrate_to_supabase.js
# to import current local JSON content into Supabase (requires service role key).
